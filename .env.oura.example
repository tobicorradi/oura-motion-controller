# Local-only paths. Never use VITE_ prefixes for Oura values.
OPEN_OURA_DIR=/absolute/path/to/open_oura
OURA_KEY_FILE=/absolute/path/outside/this/repository/key.hex
OURA_RING_NAME=Oura
# Optional only when the platform identifier is stable. On macOS it can rotate;
# otherwise leave this blank and open_oura selects the strongest matching ring.
OURA_RING_ADDRESS=
OURA_SCAN_TIMEOUT=45
OURA_SERVER_PORT=8088
OURA_STREAM_MINUTES=15
# Optional diagnostics for scan/pair/verify: debug | info | warn
# OURA_LOG_LEVEL=debug
